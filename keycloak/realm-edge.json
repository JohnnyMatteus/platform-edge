{
  "realm": "edge",
  "displayName": "Edge (dev)",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "waitIncrementSeconds": 60,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "passwordPolicy": "length(12) and notUsername",
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "attributes": {},
  "roles": {
    "realm": [
      {
        "name": "payments.read",
        "description": "Consultar pagamentos"
      },
      {
        "name": "payments.write",
        "description": "Criar e estornar pagamentos"
      },
      {
        "name": "studios.read",
        "description": "Consultar agenda e aulas dos estudios"
      },
      {
        "name": "studios.admin",
        "description": "Administrar estudios, planos e instrutores"
      }
    ]
  },
  "clients": [
    {
      "clientId": "studio-portal",
      "name": "Portal dos estudios (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audience-edge-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "edge-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "payments-ops",
      "name": "Backoffice de pagamentos",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-payments-ops-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "audience-edge-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "edge-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "partner-batch",
      "name": "Integracao batch de parceiro",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-partner-batch-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-edge-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "edge-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ana.operadora",
      "email": "ana.operadora@example.com",
      "firstName": "Ana",
      "lastName": "Operadora",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "payments.read",
        "payments.write"
      ]
    },
    {
      "username": "bruno.instrutor",
      "email": "bruno.instrutor@example.com",
      "firstName": "Bruno",
      "lastName": "Instrutor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "studios.read"
      ]
    },
    {
      "username": "carla.gestora",
      "email": "carla.gestora@example.com",
      "firstName": "Carla",
      "lastName": "Gestora",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-change-me",
          "temporary": false
        }
      ],
      "realmRoles": [
        "studios.read",
        "studios.admin"
      ]
    },
    {
      "username": "diego.visitante",
      "email": "diego.visitante@example.com",
      "firstName": "Diego",
      "lastName": "Visitante",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-change-me",
          "temporary": false
        }
      ],
      "realmRoles": []
    },
    {
      "username": "service-account-partner-batch",
      "enabled": true,
      "serviceAccountClientId": "partner-batch",
      "realmRoles": [
        "payments.read",
        "payments.write"
      ]
    }
  ],
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "edge-dev-only-rs256",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "priority": [
            "1000"
          ],
          "enabled": [
            "true"
          ],
          "active": [
            "true"
          ],
          "algorithm": [
            "RS256"
          ],
          "keyUse": [
            "SIG"
          ],
          "privateKey": [
            ""
          ],
          "certificate": [
            ""
          ]
        }
      },
      {
        "name": "hmac-generated",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "algorithm": [
            "HS512"
          ]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ]
        }
      }
    ]
  }
