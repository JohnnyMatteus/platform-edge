# Copie para .env para mudar portas ou credenciais locais: cp .env.example .env
# Tudo aqui é DEV ONLY. Nunca coloque segredos reais neste arquivo.

# Profiles do docker compose usados por `make up` (core, observability, tools).
COMPOSE_PROFILES=core,observability

# Portas publicadas no host
GATEWAY_PROXY_PORT=8000
GATEWAY_STATUS_PORT=8100
GATEWAY_REPLICA_PORT=8001
VAULT_PORT=8200
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_UI_PORT=16686
LOCALSTACK_PORT=4566
# O Keycloak fica fixo em 8080: a porta faz parte do issuer conferido pelo gateway.

# Credenciais locais
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=dev-only-change-me
VAULT_DEV_ROOT_TOKEN=dev-only-root-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev-only-change-me
AWS_DEFAULT_REGION=us-east-1
