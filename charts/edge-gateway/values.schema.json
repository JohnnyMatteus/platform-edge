{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "securityContext", "podSecurityContext"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "declarativeConfig": {
      "type": "object",
      "properties": {
        "existingConfigMap": { "type": "string" },
        "key": { "type": "string", "minLength": 1 },
        "inline": { "type": "string" }
      }
    },
    "extraEnv": {
      "type": "object",
      "propertyNames": { "pattern": "^KONG_[A-Z0-9_]+$" },
      "additionalProperties": { "type": "string" }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot"],
      "properties": { "runAsNonRoot": { "const": true } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "tlsSecretName": { "type": "string" }
      }
    }
  }
}
